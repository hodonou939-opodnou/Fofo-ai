# Supabase (local dev: run `supabase start` and copy the printed values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site — base for share-link previews (WhatsApp, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ElevenLabs Music (paid plan required) — the main provider: used whenever set.
# The key starts with sk_ (shown once, when the key is created).
ELEVENLABS_API_KEY=

# Stability AI (Stable Audio) — fallback, used only without an ElevenLabs key.
# With neither key, /api/generate answers 503 service_unavailable instead of
# generating anything.
STABILITY_API_KEY=

# Set to "mock" only for integration/e2e test runs, never in a deployed
# environment — swaps in a fake provider so tests never spend real credits.
# Ignored on a Vercel production deployment (VERCEL_ENV=production).
GENERATION_PROVIDER=
